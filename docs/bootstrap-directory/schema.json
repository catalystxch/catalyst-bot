{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalystxch.com/schemas/bootstrap-directory-v1.json",
  "title": "CATalyst Bootstrap static directory record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "network",
    "asset_id",
    "ticker",
    "manifest_campaign_id",
    "expires_at",
    "signing_address",
    "signer_public_key",
    "signature",
    "message_digest",
    "asset_verification_status",
    "signed_manifest"
  ],
  "properties": {
    "schema": { "const": "catalyst.bootstrap.directory.v1" },
    "network": { "enum": ["mainnet", "testnet"] },
    "asset_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ticker": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,15}$" },
    "manifest_campaign_id": { "type": "string", "pattern": "^bootstrap_[0-9a-f]{64}$" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "signing_address": { "type": "string", "pattern": "^(xch|txch)1[0-9a-z]{20,90}$" },
    "signer_public_key": { "type": "string", "pattern": "^[0-9a-f]{96}$" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{192}$" },
    "message_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "asset_verification_status": { "enum": ["VERIFIED", "UNVERIFIED_ASSET"] },
    "signed_manifest": { "$ref": "#/$defs/signedManifest" }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "stageThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_fills", "settlement_clusters", "stable_seconds"],
      "properties": {
        "confirmed_fills": { "type": "integer", "minimum": 0 },
        "settlement_clusters": { "type": "integer", "minimum": 0 },
        "stable_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "network", "asset_id", "ticker", "anchor_price",
        "minimum_price", "maximum_price", "created_at", "expires_at",
        "offer_levels_per_side", "capacity_stages", "stage_thresholds",
        "anchor_caps", "adverse_fill_cooldown_seconds", "loss_stop_fraction",
        "partial_offers"
      ],
      "properties": {
        "schema": { "const": "catalyst.bootstrap.manifest.v1" },
        "network": { "enum": ["mainnet", "testnet"] },
        "asset_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ticker": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,15}$" },
        "anchor_price": { "$ref": "#/$defs/canonicalDecimal" },
        "minimum_price": { "$ref": "#/$defs/canonicalDecimal" },
        "maximum_price": { "$ref": "#/$defs/canonicalDecimal" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "offer_levels_per_side": { "const": 3 },
        "capacity_stages": {
          "const": ["0.1", "0.25", "0.5", "1"]
        },
        "stage_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discovery_25", "discovery_50", "established"],
          "properties": {
            "discovery_25": { "$ref": "#/$defs/stageThreshold" },
            "discovery_50": { "$ref": "#/$defs/stageThreshold" },
            "established": { "$ref": "#/$defs/stageThreshold" }
          }
        },
        "anchor_caps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hourly", "daily"],
          "properties": {
            "hourly": { "const": "0.05" },
            "daily": { "const": "0.2" }
          }
        },
        "adverse_fill_cooldown_seconds": { "const": 300 },
        "loss_stop_fraction": { "const": "0.05" },
        "partial_offers": { "const": "disabled_until_capability_proven" }
      }
    },
    "signatureEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signing_address", "public_key", "signature", "message_digest"],
      "properties": {
        "algorithm": { "const": "chia-bls-aug-synthetic-v1" },
        "signing_address": { "type": "string", "pattern": "^(xch|txch)1[0-9a-z]{20,90}$" },
        "public_key": { "type": "string", "pattern": "^[0-9a-f]{96}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{192}$" },
        "message_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signedManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "signature"],
      "properties": {
        "manifest": { "$ref": "#/$defs/manifest" },
        "signature": { "$ref": "#/$defs/signatureEnvelope" }
      }
    }
  }
}
