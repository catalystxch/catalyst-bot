+//! Actual resync API implementation, disposable pre-captured DB only.
+//! No initialize/login/keychain loading, network, original profile or latch.
+use chia_wallet_sdk::prelude::*;
+use sage::Sage;
+use sage_api::Resync;
+use sage_database::Database;
+use sage_wallet::{ChildKind, PuzzleContext, insert_puzzle, validate_wallet_coin};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+fn hash(s: &str) -> Bytes32 {
+    hex::decode(s).unwrap().try_into().unwrap()
+}
+
+#[tokio::test]
+async fn actual_coin_only_resync_preserves_metadata_and_rebuilds_exact_receipt() {
+    let snapshot = std::env::var_os("SAGE_DISPOSABLE_SNAPSHOT")
+        .expect("explicit disposable snapshot required");
+    let source = std::path::PathBuf::from(snapshot);
+    assert_eq!(
+        source.file_name().unwrap(),
+        "disposable-harvestr-recovery.sqlite"
+    );
+    let root = std::env::temp_dir().join(format!(
+        "sage-resync-fixture-{}-{}",
+        std::process::id(),
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    let mut api = Sage::new(&root, true);
+    assert!(api.config.global.fingerprint.is_none());
+    let path = api.wallet_db_path(3702373391).unwrap();
+    std::fs::copy(source, &path).unwrap();
+    let pool = api.connect_to_database(3702373391).await.unwrap();
+    let before: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM coins")
+        .fetch_one(&pool)
+        .await
+        .unwrap();
+    assert!(before > 0);
+    let mut retained = Vec::new();
+    for table in ["assets", "offers", "p2_puzzles", "public_keys"] {
+        let n: i64 = sqlx::query_scalar(&format!("SELECT COUNT(*) FROM {table}"))
+            .fetch_one(&pool)
+            .await
+            .unwrap();
+        retained.push((table, n));
+    }
+    api.resync(Resync {
+        fingerprint: 3702373391,
+        delete_coins: true,
+        delete_assets: false,
+        delete_files: false,
+        delete_offers: false,
+        delete_addresses: false,
+        delete_blocks: false,
+    })
+    .await
+    .unwrap();
+    let n: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM coins")
+        .fetch_one(&pool)
+        .await
+        .unwrap();
+    assert_eq!(n, 0);
+    for (table, n) in retained {
+        let actual: i64 = sqlx::query_scalar(&format!("SELECT COUNT(*) FROM {table}"))
+            .fetch_one(&pool)
+            .await
+            .unwrap();
+        assert_eq!(actual, n);
+    }
+    let parent = Coin::new(
+        hash("d8186ea88e378d22848729ddef1ea420bfa3c2ba67d3b1c5a7d1310766eda686"),
+        hash("04466c09a14143ec0d8b88ad4b38c6f9a94703138f824997f667f300937754cf"),
+        0,
+    );
+    let child = Coin::new(
+        parent.coin_id(),
+        hash("25c64fb600509f0dfcc04e3cb5492c9ca72c63e5b80828981a7ee721df241f4d"),
+        98276643,
+    );
+    let puzzle = Program::from(
+        hex::decode(
+            include_str!("../../sage-wallet/src/fixtures/harvestr_parent_puzzle.hex").trim(),
+        )
+        .unwrap(),
+    );
+    let solution = Program::from(
+        hex::decode(
+            include_str!("../../sage-wallet/src/fixtures/harvestr_parent_solution.hex").trim(),
+        )
+        .unwrap(),
+    );
+    let kind = ChildKind::from_parent(parent, &puzzle, &solution, child).unwrap();
+    let db = Database::new(pool.clone());
+    let mut tx = db.tx().await.unwrap();
+    tx.insert_coin(CoinState::new(child, None, Some(9424451)))
+        .await
+        .unwrap();
+    assert!(
+        validate_wallet_coin(&mut tx, child.coin_id(), &kind)
+            .await
+            .unwrap()
+    );
+    assert!(
+        insert_puzzle(
+            &mut tx,
+            CoinState::new(child, None, Some(9424451)),
+            kind,
+            PuzzleContext::None,
+            None
+        )
+        .await
+        .unwrap()
+    );
+    tx.commit().await.unwrap();
+    let cat = db.cat_coin(child.coin_id()).await.unwrap().unwrap();
+    assert_eq!(cat.coin.amount, 98276643);
+    assert_eq!(
+        cat.info.asset_id,
+        hash("b8edcc6a7cf3738a3806fdbadb1bbcfc2540ec37f6732ab3a6a4bbcd2dbec105")
+    );
+    assert_eq!(
+        cat.info.p2_puzzle_hash,
+        hash("57d46e4646727fc15530f79cf94b41048cade4642d6b7c89008c36ab082a2347")
+    );
+    assert!(cat.lineage_proof.is_some());
+    let history = db.transaction(9424451).await.unwrap().unwrap();
+    let flow = history
+        .created
+        .iter()
+        .find(|x| x.coin.coin_id() == child.coin_id())
+        .unwrap();
+    assert_eq!(flow.asset.hash, cat.info.asset_id);
+    assert_eq!(flow.p2_puzzle_hash, Some(cat.info.p2_puzzle_hash));
+    assert!(api.config.global.fingerprint.is_none());
+    pool.close().await;
+    // Preserve disposable outputs for audit; never delete a user profile.
+    println!("disposable API recovery output: {}", root.display());
+}
