@@ -0,0 +1,25 @@
+/// Missing parent evidence must not finalize an unknown puzzle as XCH.
+pub(crate) fn defer_unknown_asset(kind_known: bool, custody_puzzle_known: bool) -> bool {
+    !kind_known && !custody_puzzle_known
+}
+
+#[cfg(test)]
+mod tests {
+    use super::defer_unknown_asset;
+
+    #[test]
+    fn missing_parent_remains_retryable() {
+        assert!(defer_unknown_asset(false, false));
+    }
+
+    #[test]
+    fn proved_parent_allows_normal_cat_validation() {
+        assert!(!defer_unknown_asset(true, false));
+    }
+
+    #[test]
+    fn registered_custody_puzzle_keeps_xch_path() {
+        assert!(!defer_unknown_asset(false, true));
+        assert!(!defer_unknown_asset(true, true));
+    }
+}
