@@ -0,0 +1,118 @@
+//! Public-chain regression fixture; no keys, RPC or original database.
+use chia_wallet_sdk::prelude::*;
+use sage_database::Database;
+use sqlx::sqlite::SqlitePoolOptions;
+
+use crate::{ChildKind, PuzzleContext, insert_puzzle, validate_wallet_coin};
+
+fn hash(value: &str) -> Bytes32 {
+    hex::decode(value).unwrap().try_into().unwrap()
+}
+
+#[tokio::test]
+async fn exact_ephemeral_parent_registers_owned_cat_and_lineage() -> anyhow::Result<()> {
+    let asset = hash("b8edcc6a7cf3738a3806fdbadb1bbcfc2540ec37f6732ab3a6a4bbcd2dbec105");
+    let inner = hash("57d46e4646727fc15530f79cf94b41048cade4642d6b7c89008c36ab082a2347");
+    let parent = Coin::new(
+        hash("d8186ea88e378d22848729ddef1ea420bfa3c2ba67d3b1c5a7d1310766eda686"),
+        hash("04466c09a14143ec0d8b88ad4b38c6f9a94703138f824997f667f300937754cf"),
+        0,
+    );
+    let child = Coin::new(
+        parent.coin_id(),
+        hash("25c64fb600509f0dfcc04e3cb5492c9ca72c63e5b80828981a7ee721df241f4d"),
+        98276643,
+    );
+    assert_eq!(
+        child.coin_id(),
+        hash("f80e20e4ab1f21815b9cd34bb64ae95ff11d83b2ea1dcb18be15c0e698c3c509")
+    );
+    let puzzle = Program::from(hex::decode(
+        include_str!("fixtures/harvestr_parent_puzzle.hex").trim(),
+    )?);
+    let solution = Program::from(hex::decode(
+        include_str!("fixtures/harvestr_parent_solution.hex").trim(),
+    )?);
+    let kind = ChildKind::from_parent(parent, &puzzle, &solution, child)?;
+    let ChildKind::Cat {
+        info,
+        lineage_proof,
+        ..
+    } = &kind
+    else {
+        panic!("Exact validated parent must classify this child as CAT");
+    };
+    assert_eq!(info.asset_id, asset);
+    assert_eq!(info.p2_puzzle_hash, inner);
+    assert_eq!(
+        lineage_proof.parent_parent_coin_info,
+        parent.parent_coin_info
+    );
+    assert_eq!(lineage_proof.parent_amount, 0);
+    let expected_lineage = *lineage_proof;
+
+    let pool = SqlitePoolOptions::new()
+        .max_connections(1)
+        .connect("sqlite::memory:")
+        .await?;
+    sqlx::migrate!("../../migrations").run(&pool).await?;
+    let db = Database::new(pool.clone());
+    db.run_rust_migrations("XCH".into()).await?;
+    let mut tx = db.tx().await?;
+    tx.insert_height(9424451).await?;
+    tx.insert_coin(CoinState::new(child, None, Some(9424451)))
+        .await?;
+    assert!(!validate_wallet_coin(&mut tx, child.coin_id(), &kind).await?);
+    tx.commit().await?;
+    // Register only the exact pre-proven wallet inner puzzle in this disposable DB.
+    sqlx::query("INSERT INTO p2_puzzles(hash,kind) VALUES(?,0)")
+        .bind(inner.as_ref())
+        .execute(&pool)
+        .await?;
+    // The foreign-wallet check deliberately deleted its rejected coin.
+    let mut tx = db.tx().await?;
+    tx.insert_coin(CoinState::new(child, None, Some(9424451))).await?;
+    tx.commit().await?;
+    assert_eq!(db.unsynced_coins(100).await?.len(), 1);
+    assert!(crate::queues::asset_discovery::defer_unknown_asset(
+        false, false
+    ));
+    // Simulate the observed released fallback state, then only in this
+    // disposable database exercise the documented delete_coins resync semantics.
+    db.update_coin(child.coin_id(), Bytes32::default(), child.puzzle_hash)
+        .await?;
+    assert!(db.unsynced_coins(100).await?.is_empty());
+    sqlx::query("DELETE FROM coins").execute(&pool).await?;
+    let mut tx = db.tx().await?;
+    tx.insert_coin(CoinState::new(child, None, Some(9424451)))
+        .await?;
+    assert!(validate_wallet_coin(&mut tx, child.coin_id(), &kind).await?);
+    assert!(
+        insert_puzzle(
+            &mut tx,
+            CoinState::new(child, None, Some(9424451)),
+            kind,
+            PuzzleContext::None,
+            None
+        )
+        .await?
+    );
+    tx.commit().await?;
+    let cat = db
+        .cat_coin(child.coin_id())
+        .await?
+        .expect("owned CAT inventory");
+    assert_eq!(cat.info.asset_id, asset);
+    assert_eq!(cat.info.p2_puzzle_hash, inner);
+    assert_eq!(cat.lineage_proof, Some(expected_lineage));
+    assert!(db.unsynced_coins(100).await?.is_empty());
+    let history = db.transaction(9424451).await?.expect("receipt history");
+    let received = history
+        .created
+        .iter()
+        .find(|flow| flow.coin.coin_id() == child.coin_id())
+        .expect("exact created receipt");
+    assert_eq!(received.asset.hash, asset);
+    assert_eq!(received.p2_puzzle_hash, Some(inner));
+    Ok(())
+}
